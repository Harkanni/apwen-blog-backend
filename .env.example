# Copy to .env and fill in. Real environment variables override this file.
PORT=4000
NODE_ENV=development

# Long random string (32+ chars). Required in production.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# First admin account, created automatically when the database has no users.
ADMIN_EMAIL=admin@apwen.org.ng
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Content Team

# Where the SQLite database and uploaded images live. Mount a persistent disk here in production.
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Only needed if browsers call the API directly (the frontend normally proxies /api and /uploads).
CORS_ORIGINS=
# Set true when served over HTTPS (defaults to true when NODE_ENV=production).
COOKIE_SECURE=
